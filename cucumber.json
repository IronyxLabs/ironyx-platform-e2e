{
  "default": {
    "paths": [
      "features/**/*.feature"
    ],
    "import": [
      "features/**/*.ts",
      "src/**/*.ts"
    ],
    "format": [
      "progress"
    ],
    "loader": [
      "ts-node/esm"
    ],
    "worldParameters": {
      "serviceIndexUri": "http://localhost:5900"
    }
  },
  "dev": {
    "paths": [
      "features/**/*.feature"
    ],
    "import": [
      "features/**/*.ts",
      "src/**/*.ts"
    ],
    "format": [
      "progress"
    ],
    "loader": [
      "ts-node/esm"
    ],
    "worldParameters": {
      "serviceIndexUri": "http://localhost:5900"
    }
  }
}
